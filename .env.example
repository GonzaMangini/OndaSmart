# Copiá este archivo como .env.local y completá los valores.
# Los encontrás en Supabase → botón "Connect" (o Project Settings → API Keys).
# El prefijo NEXT_PUBLIC_ hace que la variable llegue al navegador.
# Es seguro para la publishable key: la protección real está en las reglas RLS de la base.
# NUNCA pongas acá la contraseña de la base ni la "secret key".
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
