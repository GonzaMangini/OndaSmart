# Copiá este archivo como .env.local y completá los valores.
# Los encontrás en Supabase → Project Settings → API.
# El prefijo NEXT_PUBLIC_ hace que la variable llegue al navegador.
# Esto es seguro para la anon key: la protección real está en las reglas RLS de la base.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
